namespace Sendfile {
};

[Error]
enum SendfileError {
  "ClientHttpErrorResponse",
  "ClientApiErrorResponse",
  "WebSocketClosed",
  "IO",
  "HTTPClient",
  "RTCDataChannel",
  "WebSocketClient",
  "InvalidPeerMessage",
  "InvalidInput",
  "InvalidCipherKey",
  "Decrypt",
  "InvalidServerResponse",
  "Timeout",
};

interface UploaderClient {
  [Name=new_ffi, Throws=SendfileError]
  constructor([ByRef] string api_endpoint, [ByRef] string download_endpoint, Transport transport);

  [Throws=SendfileError]
  NativeProvisionedFile provision_file_ffi([ByRef] string path);

  [Throws=SendfileError]
  void upload_provisioned_file_ffi([ByRef] NativeProvisionedFile provisioned_file);
};

enum Transport {
  "P2P",
  "Relay",
  "Both",
};

interface NativeProvisionedFile {
  string formatted_download_url_and_key();
};

interface DownloaderClient {
  [Name=from_download_url_ffi, Throws=SendfileError]
  constructor([ByRef] string download_url, [ByRef] string api_endpoint, Transport transport);

  [Throws=SendfileError]
  DownloadMeta fetch_meta_ffi();

  [Throws=SendfileError]
  void download_ffi([ByRef] DownloadMeta meta, string? output_dir, duration? p2p_timeout);
};

interface DownloadMeta {
  FileMeta file_meta_ffi();
};

dictionary FileMeta {
  string file_name;
  u64 file_size;
};
