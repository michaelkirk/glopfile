#!/usr/bin/env bash
set -e
set -x

WWW_CLIENT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$WWW_CLIENT"

rm -fr rust/pkg
wasm-pack build --release --target bundler rust

rm -fr glopfile/dist
rm -fr glopfile/node_modules
(cd glopfile && yarn install && yarn tsc)

rm -fr glopfile-ui/build
rm -fr glopfile-ui/node_modules

# Build for deploy
(cd glopfile-ui && yarn install && yarn build)
# Compress for deploy: caddy serves the .gz to whoever accepts it, and we keep
# (-k) the original for whoever does not.
(cd glopfile-ui/build && find . -type f -name \*.wasm | xargs gzip -k -9)

# Serve for dev
# (cd glopfile-ui && yarn install && yarn start)
