[Unit]
Description=Sendfile relay
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/bin/erl -config config/sys.config -noinput -sname sendfile@localhost -s sendfile_app
Environment="ERL_LIBS=_build/default/lib" "HOME=/var/lib/sendfile"
WorkingDirectory=/var/lib/sendfile
User=sendfile
DynamicUser=yes
StateDirectory=sendfile
Restart=always
RestartSec=12
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=default.target
