[Unit]
Description=Sendfile relay
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/sendfile
Environment="SENDFILE_LISTEN=0.0.0.0:8080" "RUST_LOG=info"
WorkingDirectory=/var/lib/sendfile
User=sendfile
DynamicUser=yes
StateDirectory=sendfile
Restart=always
RestartSec=12
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=default.target
