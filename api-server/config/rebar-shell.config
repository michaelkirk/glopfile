[{sendfile,
  [{port, 8080}]},
 {kernel,
  [{inet_dist_use_interface, {127,0,0,1}},
   {logger_level, debug},
   {logger,
    [{handler, default, logger_std_h,
      #{config => #{type => standard_io},
        formatter =>
            {logger_formatter,
             #{legacy_header => false,
               single_line => true,
               time_designator => $ ,
               template => [time," ",level," ", pid," ",mfa,":",line," === ",msg,"\n"]}}
       }},
     {handler, disk_log, logger_disk_log_h,
      #{config => #{file => "./log/sendfile.log"},
        formatter =>
            {logger_formatter,
             #{legacy_header => false,
               single_line => true,
               time_designator => $ ,
               template => [time," ",level," ", pid," ",mfa,":",line," === ",msg,"\n"]}}
       }}
    ]}
  ]}
].
