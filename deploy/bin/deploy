#!/bin/bash
#
# Install or update the relay on this host. Idempotent; safe to re-run.
#
#   deploy/bin/deploy [--image IMAGE] [--port PORT]
#
# Pulls the image, installs the compose file and unit if they are missing or
# stale, and restarts the service. Run it on the host, as root.
set -euo pipefail

INSTALL_DIR=/opt/glopfile
CONFIG_DIR=/etc/glopfile
UNIT=glopfile-relay.service
SOURCE_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../production" && pwd)

image=""
port=""
while [ $# -gt 0 ]; do
  case $1 in
    --image) image=$2; shift 2 ;;
    --port)  port=$2;  shift 2 ;;
    -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 64 ;;
  esac
done

[ "$(id -u)" -eq 0 ] || { echo "must run as root" >&2; exit 1; }
command -v docker >/dev/null || { echo "docker is not installed" >&2; exit 1; }

install -d -m 755 "$INSTALL_DIR" "$CONFIG_DIR"
install -m 644 "$SOURCE_DIR/docker-compose.yml" "$INSTALL_DIR/docker-compose.yml"
install -m 644 "$SOURCE_DIR/$UNIT" "/etc/systemd/system/$UNIT"

# Keep whatever is already configured; only fill in what the caller passed.
if [ ! -e "$CONFIG_DIR/relay.env" ]; then
  install -m 644 "$SOURCE_DIR/relay.env.example" "$CONFIG_DIR/relay.env"
  echo "wrote $CONFIG_DIR/relay.env from the example"
fi
set_env() {
  local key=$1 value=$2
  [ -n "$value" ] || return 0
  if grep -qE "^${key}=" "$CONFIG_DIR/relay.env"; then
    sed -i -E "s|^${key}=.*|${key}=${value}|" "$CONFIG_DIR/relay.env"
  else
    printf '%s=%s\n' "$key" "$value" >> "$CONFIG_DIR/relay.env"
  fi
}
set_env GLOPFILE_IMAGE "$image"
set_env GLOPFILE_PORT "$port"

systemctl daemon-reload
systemctl enable "$UNIT" >/dev/null
# Pull before restarting so the service is down only for the restart itself.
( cd "$INSTALL_DIR" && env $(grep -vE '^\s*#' "$CONFIG_DIR/relay.env" | xargs) docker compose pull )
systemctl restart "$UNIT"

echo "waiting for the relay to answer..."
listen_port=$(grep -E '^GLOPFILE_PORT=' "$CONFIG_DIR/relay.env" | cut -d= -f2)
listen_port=${listen_port:-8080}
for _ in $(seq 1 30); do
  if curl -fsS "http://127.0.0.1:${listen_port}/api/v1/health_check" >/dev/null 2>&1; then
    echo "relay is up on 127.0.0.1:${listen_port}"
    exit 0
  fi
  sleep 1
done

echo "relay did not come up; last log lines:" >&2
journalctl -u "$UNIT" --no-pager -n 30 >&2
exit 1
