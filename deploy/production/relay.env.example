# Copy to /etc/sendfile/relay.env. Every value here is optional.

# The image to run. Pin a digest or tag for a reproducible deploy.
SENDFILE_IMAGE=ghcr.io/privacyresearchgroup/sendfile:latest

# Loopback port the reverse proxy forwards to.
SENDFILE_PORT=8080

# tracing-subscriber filter, e.g. sendfile=debug to see per-session activity.
RUST_LOG=info
