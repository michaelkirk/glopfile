# Copy to /etc/glopfile/relay.env. Every value here is optional.

# The image to run. Pin a digest or tag for a reproducible deploy.
GLOPFILE_IMAGE=ghcr.io/michaelkirk/glopfile:latest

# Loopback port the reverse proxy forwards to.
GLOPFILE_PORT=8080

# tracing-subscriber filter, e.g. glopfile=debug to see per-session activity.
RUST_LOG=info
